APP_NAME="Wedly"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development and tests use SQLite so the project runs without extra services.
# Production targets PostgreSQL 17; see docker-compose.yml, web/.env.postgres.example
# and wedding-platform-blueprint/docs/adr/005-sqlite-local-postgres-production.md.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=undangan
# DB_USERNAME=undangan
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt the session payload at rest. Keep true outside throwaway local work.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure cookies are automatic when APP_ENV=production; set false only when
# running production code over plain HTTP locally.
# SESSION_SECURE_COOKIE=

# Hardening (docs/SECURITY.md, section 8-9). The CSP runs report-only until
# violations posted to /csp-reports are reviewed, then set this to false.
SECURITY_CSP_REPORT_ONLY=true
# Optional full policy override, e.g. when a CDN or analytics host is added.
# SECURITY_CSP_POLICY=
ADMIN_REQUIRE_TWO_FACTOR=false
REGISTER_RATE_LIMIT=5
TWO_FACTOR_RATE_LIMIT=5

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email: address verification, payment confirmation, proof of transfer, and
# enquiry notices are sent synchronously. Resend is the supported transport
# (`MAIL_MAILER=resend` plus `RESEND_API_KEY`); use `log` locally to write
# messages to storage/logs instead of delivering them. `onboarding@resend.dev`
# only delivers to the address that owns the Resend account, so production needs
# a verified domain; until then set `MAIL_REDIRECT_TO` to that inbox and every
# message is funneled there instead of failing at the provider.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="Wedly Studio"
MAIL_REDIRECT_TO=
RESEND_API_KEY=

# Public contact details shown on the landing and legal pages (config/site.php).
# Leave CONTACT_WHATSAPP empty to hide the WhatsApp call to action.
CONTACT_EMAIL="lencakstudio@gmail.com"
CONTACT_PHONE="081391515363"
CONTACT_WHATSAPP="081391515363"
CONTACT_MAPS_URL="https://maps.app.goo.gl/Ejsyx1UxHtUw2LZT6"

# Business policy defaults. These are hypotheses until validated (docs/BUSINESS_MODEL.md).
INVITATION_DEFAULT_ACTIVE_MONTHS=12
PUBLIC_INVITATION_RATE_LIMIT=60

# Guests and RSVP. Personal links are bearer secrets, so the personalised page and
# the RSVP submission are throttled per IP (docs/SECURITY.md, section 9).
GUEST_INVITATION_RATE_LIMIT=60
GUEST_RSVP_RATE_LIMIT=10
GUEST_MAX_PARTY_SIZE=20
GUEST_IMPORT_MAX_ROWS=500
# RSVP reminders are transactional email to guests who supplied an address; the
# cooldown keeps scheduled runs from nagging.
GUEST_REMINDER_COOLDOWN_DAYS=7
GUEST_REMINDER_BATCH_LIMIT=200

# Landing showcase, testimonial and enquiry-form limits (config/platform.php).
MARKETING_LEAD_RATE_LIMIT=6
MARKETING_SHOWCASE_LIMIT=24
MARKETING_TESTIMONIAL_LIMIT=6

# Gallery and archive. Media bytes are written to a private disk and only served
# through short-lived signed URLs (docs/MEDIA_STORAGE.md, ADR 003, ADR 009).
MEDIA_DISK=media
MEDIA_MAX_FILES_PER_UPLOAD=10
MEDIA_MAX_FILE_KB=8192
# Ceiling for every photo in one submit. Both limits are lowered to PHP's
# upload_max_filesize/post_max_size when the host is stricter.
MEDIA_MAX_UPLOAD_KB=24576
MEDIA_RESPECT_PHP_LIMITS=true
MEDIA_MAX_PIXELS=24000000
MEDIA_MAX_DIMENSION=8000
MEDIA_PREVIEW_MAX_WIDTH=1280
MEDIA_THUMBNAIL_MAX_WIDTH=400
MEDIA_SIGNED_URL_TTL_MINUTES=15
MEDIA_ARCHIVE_RETENTION_DAYS=7
MEDIA_ARCHIVE_MAX_ASSETS=200
MEDIA_ARCHIVE_MAX_BYTES=536870912
MEDIA_CLEANUP_QUARANTINE_HOURS=24
MEDIA_PUBLIC_RATE_LIMIT=30
# Optional malware scanner, e.g. "clamdscan --no-summary --stdout". When empty
# uploads are inspected by MIME/dimension checks only. Output containing
# FOUND, or a non-zero exit while MEDIA_SCAN_FAIL_CLOSED=true, rejects the file.
# MEDIA_SCAN_COMMAND=
MEDIA_SCAN_FAIL_CLOSED=true

# Payments use a manual bank transfer: the customer transfers the package price
# plus a unique three-digit code and uploads the proof within PAYMENT_WINDOW_HOURS.
# PAYMENT_BANK_ACCOUNTS lists every account shown on the instruction page as
# "bank|account number|account holder", separated by semicolons.
PAYMENT_GATEWAY=bank_transfer
PAYMENT_WINDOW_HOURS=24
PAYMENT_BANK_ACCOUNTS="BCA|1234567890|Nama Pemilik Rekening;Mandiri|9876543210|Nama Pemilik Rekening"
PAYMENT_PROOF_DISK=local
PAYMENT_PROOF_MAX_KB=4096
# Sandbox provider for local demos and tests. It is off by default and is also
# refused in production. The webhook secret has no fallback: leave it empty to
# keep the signed webhook endpoint closed, and set a value that is not this
# placeholder whenever PAYMENT_FAKE_ENABLED=true.
PAYMENT_FAKE_ENABLED=false
PAYMENT_FAKE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
